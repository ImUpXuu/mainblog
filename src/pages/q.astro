---
import SpecLayout from "@/layouts/SpecLayout.astro";
import { profileConfig, siteConfig } from "@/config";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"@id": `${siteConfig.site_url}/q`,
	name: "QQ群",
	description: "加入 UpXuu 的 QQ 交流群",
	url: `${siteConfig.site_url}/q`,
	author: {
		"@type": "Person",
		name: profileConfig.name,
	},
	inLanguage: siteConfig.lang.replace("_", "-"),
};
---

<SpecLayout
	title="QQ群"
	description="加入 UpXuu 的 QQ 交流群"
	bodyId="spec-page"
	class="mx-4 mt-0 mb-8"
>
	<script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json"></script>

	<div class="card-base w-full rounded-[var(--radius-large)] px-6 md:px-9 py-8">
		<div class="mb-10 text-center">
			<h1 class="text-4xl font-bold text-gray-800 dark:text-gray-200 mb-3">
				💬 QQ 交流群
			</h1>
			<p class="text-gray-600 dark:text-gray-400">
				扫码加入，一起聊天交流
			</p>
		</div>

		<div class="flex justify-center mb-8">
			<img
				src="https://edit.upxuu.com/img/2026/4/26/20260426203928_741.png"
				alt="QQ群二维码"
				class="rounded-xl shadow-lg max-w-sm w-full"
				loading="lazy"
			/>
		</div>

		<div class="text-center text-xs text-gray-400 dark:text-gray-500">
			使用手机 QQ 扫码加入
		</div>
	</div>
</SpecLayout>
